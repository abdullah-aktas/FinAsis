# Django
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (choose one)
USE_POSTGRES=0
USE_SQLITE=1

# Postgres (if USE_POSTGRES=1)
POSTGRES_DB=finasis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Email
DEFAULT_FROM_EMAIL=no-reply@finasis.local
SUPPORT_EMAIL=support@finasis.local
SALES_EMAIL=sales@finasis.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# GIB (test)
GIB_USERNAME=testuser
GIB_PASSWORD=testpass
GIB_TEST_MODE=1
GIB_EFATURA_BASE_URL=https://efatura-test.efatura.gov.tr/api
GIB_EDEFTER_BASE_URL=https://edefter-test.edefter.gov.tr/api

# AI / OCR (optional)
USE_GOOGLE_VISION=0
STT_ENABLED=0
VOSK_MODEL_PATH=
AI_LOCAL_ONLY=1
AI_PRIVACY_MODE=1

# DRF throttling
THROTTLE_BURST_USER=20/minute
THROTTLE_SUSTAINED_USER=1000/hour
THROTTLE_BURST_ANON=10/minute

# PayTR (optional)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_SANDBOX=1
PAYTR_ALLOWED_IPS=

# Bank transfer (sample)
BANK_TRANSFER_ENABLED=1
BANK_ACCOUNT_HOLDER=FinAsis Teknoloji A.Ş.
BANK_ACCOUNT_IBAN=TR00 0000 0000 0000 0000 0000 00
BANK_ACCOUNT_BANK=Finasis Bankası

# App meta
APP_VERSION=v1.0
BRAND_NAME=FinAsis
