# FinAsis örnek ortam değişkenleri
# Bu dosyayı kopyalayıp adını .env yapın ve değerlerinizi doldurun.

# Django temel
SECRET_KEY=degistir_bunu
DEBUG=True
USE_SQLITE=True

# GİB Entegrasyon (test değerleri)
GIB_USERNAME=testuser
GIB_PASSWORD=testpass
GIB_TEST_MODE=True
GIB_EFATURA_BASE_URL=https://efatura-test.efatura.gov.tr/api
GIB_EDEFTER_BASE_URL=https://edefter-test.edefter.gov.tr/api

# AI / OCR
USE_GOOGLE_VISION=False
STT_ENABLED=False
VOSK_MODEL_PATH=
AI_LOCAL_ONLY=True
AI_PRIVACY_MODE=True

