DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=finasis.com.tr,www.finasis.com.tr
DJANGO_SITE_BASE_URL=https://finasis.com.tr
DJANGO_CSRF_TRUSTED_ORIGINS=https://finasis.com.tr,https://www.finasis.com.tr

# Database
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=finasis
DJANGO_DB_USER=finasis
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSL_REQUIRED=False
DJANGO_DB_SSLMODE=require
CLOUD_SQL_CONNECTION_NAME=project:region:instance
DB_SOCKET_DIR=/cloudsql

# Redis / Cache
USE_REDIS=True
REDIS_URL=redis://127.0.0.1:6379/0

# Email
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL="FinAsis <noreply@finasis.com.tr>"
DJANGO_EMAIL_HOST=smtp.finasis.com.tr
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=apikey
DJANGO_EMAIL_HOST_PASSWORD=change-me

# Security & Sessions
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_IDLE_TIMEOUT=1800
SESSION_CONCURRENT_LIMIT=3
DATA_ENCRYPTION_KEY=base64-encoded-fernet-key
DATA_ENCRYPTION_FALLBACK_KEY=

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# OIDC / Keycloak
OIDC_ENABLED=False
KEYCLOAK_URL=https://keycloak.finasis.com
KEYCLOAK_REALM=finasis
KEYCLOAK_CLIENT_ID=finasis-web
KEYCLOAK_CLIENT_SECRET=
OIDC_LOGIN_REDIRECT_URL=/accounts/user_profile/
OIDC_LOGOUT_REDIRECT_URL=/accounts/login/

# Developer Portal rate limits (mirrors REST_FRAMEWORK throttle rates)
API_RATE_LIMIT_FREEMIUM=120/day
API_RATE_LIMIT_STANDARD=1000/hour
API_RATE_LIMIT_PROFESSIONAL=5000/hour
API_RATE_LIMIT_ENTERPRISE=20000/hour

# Third-party integrations
GOOGLE_APPLICATION_CREDENTIALS=/etc/finasis/google-service-account.json
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0
DJANGO_ENABLE_JSON_LOGS=True
DJANGO_SECURE_SSL_REDIRECT=True
WHITENOISE_MAX_AGE=2592000

# Regions & Pricing
FINASIS_SUPPORTED_REGIONS=TR,EU,US
FINASIS_DEFAULT_REGION=TR
FINASIS_REGIONAL_PRICING_REFRESH_CRON=0 6 * * MON

# Analytics / GTM
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Cloudflare
USE_CLOUDFLARE=False
CLOUDFLARE_IP_HEADER=CF-Connecting-IP

